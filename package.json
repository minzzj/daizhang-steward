{
  "name": "daizhang-steward",
  "version": "0.8.0",
  "private": true,
  "description": "代掌 Steward — composable operating-AI core: real browser/desktop operator, DeepSeek-Harness code loop, customer branch. Source-available, non-commercial (CC BY-NC-SA 4.0).",
  "license": "CC-BY-NC-SA-4.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "dist/apps/cli/src/index.js",
  "bin": {
    "steward": "dist/apps/cli/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"tests/unit/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:prompts": "node --test tests/unit/prompts.test.mjs",
    "demo": "npm run build && node dist/apps/cli/src/index.js demo",
    "dev": "npm run build && node dist/apps/cli/src/index.js",
    "check": "node scripts/check-scaffold.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "prompts:manifest": "node scripts/update-prompt-manifest.mjs",
    "evidence": "node scripts/run-evidence.mjs",
    "acceptance": "node scripts/run-acceptance.mjs",
    "acceptance:m2": "node scripts/run-acceptance-m2.mjs",
    "acceptance:m3": "node scripts/run-acceptance-m3.mjs",
    "acceptance:m4": "node scripts/run-acceptance-m4.mjs",
    "acceptance:p1": "node scripts/run-acceptance-p1.mjs",
    "acceptance:p2": "node scripts/run-acceptance-p2.mjs",
    "drill:long": "node scripts/run-long-drill.mjs",
    "acceptance:p3": "node scripts/run-acceptance-p3.mjs",
    "sync:delivery": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-delivery.ps1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3"
  }
}
